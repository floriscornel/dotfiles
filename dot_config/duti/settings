# duti settings: default app handlers for source/config files.
#
# Applied on every `chezmoi apply` (alias: cm apply) by
# run_06_vscode_defaults.sh, which installs duti via Homebrew when missing.
#
# Manual re-apply:  duti ~/.config/duti/settings
# VS Code Insiders: replace com.microsoft.VSCode with com.microsoft.VSCodeInsiders.

# --- JSON / YAML / config ---
com.microsoft.VSCode json all
com.microsoft.VSCode yaml all
com.microsoft.VSCode yml all
com.microsoft.VSCode toml all
com.microsoft.VSCode ini all
com.microsoft.VSCode xml all

# --- Markdown / docs ---
com.microsoft.VSCode md all
com.microsoft.VSCode markdown all
com.microsoft.VSCode rst all
com.microsoft.VSCode tex all

# --- Web (html/htm excluded on purpose: on macOS 26 public.html is tied to the
#          system default web browser, so setting it here replaces the browser) ---
com.microsoft.VSCode css all
com.microsoft.VSCode scss all
com.microsoft.VSCode less all
com.microsoft.VSCode vue all

# --- JS / TS ---
com.microsoft.VSCode js all
com.microsoft.VSCode mjs all
com.microsoft.VSCode cjs all
com.microsoft.VSCode jsx all
com.microsoft.VSCode ts all
com.microsoft.VSCode tsx all

# --- Languages ---
com.microsoft.VSCode py all
com.microsoft.VSCode pyi all
com.microsoft.VSCode go all
com.microsoft.VSCode rs all
com.microsoft.VSCode rb all
com.microsoft.VSCode php all
com.microsoft.VSCode lua all
com.microsoft.VSCode r all

# --- Shell ---
com.microsoft.VSCode sh all
com.microsoft.VSCode bash all
com.microsoft.VSCode zsh all

# --- Everyday file types ---
com.microsoft.VSCode txt all
com.microsoft.VSCode csv all
com.microsoft.VSCode ipynb all
com.microsoft.VSCode sql all
com.microsoft.VSCode ps1 all
com.microsoft.VSCode c all
com.microsoft.VSCode h all
com.microsoft.VSCode cpp all
# UTI, not an extension: every plain-text file without a more specific type,
# including extensionless ones (README, LICENSE, .gitignore).
com.microsoft.VSCode public.plain-text all

# Notes
# - Apple/Xcode-owned types (.swift, .m, .mm, .plist, .xcodeproj) are left alone.
# - .jsonc cannot be mapped: macOS gives it a dynamic UTI and LaunchServices
#   rejects setting a handler for it (duti: "error -50").
# - macOS types .ts as public.mpeg-2-transport-stream, so .ts video files also
#   open in VS Code; remove the "ts" line if you open .ts video clips.
# - A line must end with a newline: duti rejects an unterminated last line.
# - `duti -x <ext>` is unreliable on macOS 26+: it resolves the extension to a
#   shadow UTI (e.g. .md -> public.markdown, owned by Word) instead of the type
#   LaunchServices assigns to real files (net.daringfireball.markdown). The
#   apply script therefore verifies with NSWorkspace via osascript instead.
