#!/usr/bin/env bash
# Re-runs when fish_plugins changes.
# fish_plugins: {{ include "dot_config/fish/fish_plugins" | sha256sum }}

set -e

FISH="$HOME/.local/share/mise/shims/fish"
[ -x "$FISH" ] || FISH="$(command -v fish || true)"
[ -n "$FISH" ] || { echo "fish not found, skipping fisher bootstrap"; exit 0; }

"$FISH" -c '
if not functions -q fisher
    curl -sL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source
    fisher install jorgebucaran/fisher
end
fisher update
'
